APP_NAME=payment-service
APP_ENV=local
APP_PORT=8083
GRPC_PORT=9092

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payment_service

RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_EXCHANGE=parkirpintar.events

OTLP_ENDPOINT=localhost:4317

# ── Midtrans QRIS sandbox ───────────────────────────────────────────────────
# In stub mode the service never calls Midtrans — CreateQrisIntent returns
# a synthetic QRIS payload. Useful when you don't have sandbox credentials.
# Flip to false (with valid creds) to hit the real sandbox.
MIDTRANS_STUB_MODE=true
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXX
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com/v2
# HMAC signature key shared with Midtrans for webhook verification.
# Empty = skip signature check in dev (DO NOT leave empty in prod).
MIDTRANS_WEBHOOK_SECRET=

# ── JWT verification (mini-app calls /v1/payments/qris/intent) ──────────────
SUPER_APP_JWT_PUBLIC_KEY_PEM=
